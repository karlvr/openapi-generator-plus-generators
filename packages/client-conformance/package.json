{
  "name": "@openapi-generator-plus/client-conformance",
  "version": "0.1.0",
  "description": "A conformance test suite that runs a generated OpenAPI Generator Plus client against a recording HTTP server",
  "keywords": [
    "openapi-generator-plus",
    "openapi",
    "conformance",
    "testing"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "drivers",
    "specs"
  ],
  "scripts": {
    "build": "../../node_modules/.bin/tsc -p tsconfig.prod.json",
    "clean": "../../node_modules/.bin/rimraf dist",
    "watch": "../../node_modules/.bin/tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlvr/openapi-generator-plus-generators.git"
  },
  "author": "Karl von Randow",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/karlvr/openapi-generator-plus-generators/issues"
  },
  "homepage": "https://github.com/karlvr/openapi-generator-plus-generators/tree/master/packages/client-conformance#readme",
  "dependencies": {
    "@openapi-generator-plus/generator-common": "workspace:*",
    "@openapi-generator-plus/testing": "^2.33.0",
    "@openapi-generator-plus/types": "^2.23.0"
  },
  "peerDependencies": {
    "jest": ">=29"
  },
  "publishConfig": {
    "access": "public"
  }
}
